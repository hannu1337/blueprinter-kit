{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "id": "raw",
  "name": "Raw",
  "setupCli": {
    "entry": "node setup-cli.mjs",
    "timeoutSeconds": 10
  },
  "credential": {
    "kind": "cloudflare-kv",
    "namespace": "raw-operators-<stage>",
    "ttlMax": "PT1H",
    "obtain": "ops issue-token"
  },
  "outputs": [
    {
      "name": "RAW_SECRET",
      "scope": "tenant",
      "secret": true,
      "target": "api"
    }
  ],
  "overlay": ".integration/overlay"
}
